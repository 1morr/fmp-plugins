{
  "search": {
    "input": { "keyword": "钢琴", "page": 1 },
    "expect": {
      "minItems": 10,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork", "viewCount"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "BV1xx411c79H",
      "purpose": "playback",
      "formats": [{ "container": "mp4", "codec": "aac" }],
      "quality": "high"
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["url", "headers", "container", "codec", "bitrate"]
    },
    "expiresAtPattern": "[?&](?:deadline=|hdnts=exp=)(\\d+)"
  },
  "live": {
    "input": { "roomId": "1" },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["roomId", "title", "status", "area"]
    }
  },
  "importPlaylist": {
    "input": { "url": "https://space.bilibili.com/8047632/favlist?fid=4026748432" },
    "expect": { "minItems": 10, "nonEmpty": ["track"] }
  },
  "charts": {
    "input": { "chartId": "music" },
    "expect": {
      "minItems": 10,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork", "viewCount"]
    }
  },
  "login": {
    "input": {
      "cookies": {
        "SESSDATA": "fake-sessdata-0000",
        "bili_jct": "fake-jct-0000",
        "DedeUserID": "1000001",
        "DedeUserID__ckMd5": "fake-ckmd5-0000"
      }
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["userId", "displayName", "avatar"]
    },
    "requiresLogin": true
  },
  "multiPart": {
    "input": { "sourceId": "BV1YmHx6QEV6" },
    "expect": {
      "minItems": 2,
      "nonEmpty": ["cid", "title", "durationMs", "index"]
    }
  },
  "trackDetail": {
    "input": { "sourceId": "BV1xx411c79H" },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["publishedAt", "uploaderAvatar", "stats", "webUrl"]
    }
  },
  "libraryRead": {
    "input": {},
    "expect": { "minItems": 1, "nonEmpty": ["playlistId", "title"] },
    "requiresLogin": true
  },
  "libraryWrite": {
    "input": { "playlistId": "4000000001", "tracks": [{ "sourceId": "BV1fmpTest01" }] },
    "expect": { "minItems": 1 },
    "requiresLogin": true,
    "mutates": true
  }
}
