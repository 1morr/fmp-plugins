{
  "search": {
    "input": { "keyword": "钢琴", "page": 1 },
    "expect": {
      "minItems": 10,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "BV1xx411c79H",
      "purpose": "playback",
      "formats": [{ "container": "mp4", "codec": "aac" }],
      "quality": "high"
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["url", "headers", "container", "codec", "bitrate"]
    },
    "expiresAtPattern": "[?&](?:deadline=|hdnts=exp=)(\\d+)"
  },
  "login": {
    "input": {
      "cookies": {
        "SESSDATA": "fake-sessdata-0000",
        "bili_jct": "fake-jct-0000",
        "DedeUserID": "1000001",
        "DedeUserID__ckMd5": "fake-ckmd5-0000"
      }
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["userId", "displayName", "avatar"]
    },
    "requiresLogin": true
  }
}
