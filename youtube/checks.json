{
  "search": {
    "input": { "keyword": "rick astley never gonna give you up", "page": 1 },
    "expect": {
      "minItems": 5,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "dQw4w9WgXcQ",
      "purpose": "playback",
      "formats": [
        { "container": "webm", "codec": "opus" },
        { "container": "mp4", "codec": "aac" }
      ],
      "quality": "high"
    },
    "expect": {
      "minItems": 2,
      "nonEmpty": ["url", "container", "codec", "bitrate", "expiresAt"]
    },
    "expiresAtPattern": "[?&]expire=(\\d+)"
  },
  "mix": {
    "input": { "seed": { "sourceId": "dQw4w9WgXcQ" } },
    "expect": {
      "minItems": 5,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "trackDetail": {
    "input": { "sourceId": "dQw4w9WgXcQ" },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["description", "publishedAt", "uploaderAvatar", "stats"]
    }
  },
  "importPlaylist": {
    "input": { "url": "https://www.youtube.com/playlist?list=PLjxrf2q8roU23XGwz3Km7sQZFTdB996iG" },
    "expect": { "minItems": 50, "nonEmpty": ["track"] }
  },
  "charts": {
    "input": { "chartId": "new-this-week" },
    "expect": {
      "minItems": 5,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "login": {
    "input": {
      "cookies": {
        "SAPISID": "fake-sapisid",
        "__Secure-1PSID": "fake-1psid",
        "__Secure-3PSID": "fake-3psid"
      }
    },
    "expect": { "minItems": 1, "nonEmpty": ["userId", "displayName", "avatar"] },
    "requiresLogin": true
  },
  "libraryRead": {
    "input": {},
    "expect": { "minItems": 1, "nonEmpty": ["playlistId", "title"] },
    "requiresLogin": true
  },
  "libraryWrite": {
    "input": { "playlistId": "PLfmpTestFakePlaylistId000000000001", "tracks": [{ "sourceId": "aaaaaaaaaa1" }] },
    "expect": { "minItems": 1 },
    "requiresLogin": true,
    "mutates": true
  }
}
