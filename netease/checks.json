{
  "search": {
    "input": { "keyword": "周杰伦", "page": 1 },
    "expect": {
      "minItems": 10,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "139774",
      "purpose": "playback",
      "formats": [
        { "container": "mp3", "codec": "mp3" },
        { "container": "flac", "codec": "flac" }
      ],
      "quality": "high"
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["url", "headers", "container", "codec", "bitrate", "expiresAt"]
    }
  },
  "trackDetail": {
    "input": { "sourceId": "139774" },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["album", "webUrl"]
    }
  },
  "importPlaylist": {
    "input": { "url": "https://music.163.com/#/playlist?id=19723756" },
    "expect": { "minItems": 50, "nonEmpty": ["track"] }
  },
  "charts": {
    "input": { "chartId": "hot" },
    "expect": {
      "minItems": 40,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "login": {
    "input": {
      "cookies": { "MUSIC_U": "fake-music-u-0000", "__csrf": "fake-csrf-0000" }
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["userId", "displayName", "avatar"]
    },
    "requiresLogin": true
  },
  "libraryRead": {
    "input": {},
    "expect": { "minItems": 1, "nonEmpty": ["playlistId", "title"] },
    "requiresLogin": true
  },
  "libraryWrite": {
    "input": { "playlistId": "800000001", "tracks": [{ "sourceId": "900000001" }] },
    "expect": { "minItems": 1 },
    "requiresLogin": true,
    "mutates": true
  }
}
