{
  "search": {
    "input": { "keyword": "周杰伦", "page": 1 },
    "expect": {
      "minItems": 10,
      "nonEmpty": ["sourceId", "title", "uploader", "durationMs", "artwork"]
    }
  },
  "resolveStream": {
    "input": {
      "sourceId": "139774",
      "purpose": "playback",
      "formats": [
        { "container": "mp3", "codec": "mp3" },
        { "container": "flac", "codec": "flac" }
      ],
      "quality": "high"
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["url", "headers", "container", "codec", "bitrate", "expiresAt"]
    }
  },
  "login": {
    "input": {
      "cookies": { "MUSIC_U": "fake-music-u-0000", "__csrf": "fake-csrf-0000" }
    },
    "expect": {
      "minItems": 1,
      "nonEmpty": ["userId", "displayName", "avatar"]
    },
    "requiresLogin": true
  }
}
